{
  "name": "@adeficior/monorepo",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "prepare": "husky",
    "prune": "turbo run prune",
    "create": "bun run packages/builder/src/cli.ts --path modules"
  },
  "catalog": {
    "typescript": "^5",
    "zod": "^4.4.3",
    "lodash-es": "^4.18.1",
    "@types/lodash-es": "^4.17.12",
    "minimatch": "^10.2.6",
    "prettier": "^3.8.4",
    "arg": "^5.0.2",
    "command-line-usage": "^7.0.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "add": "^2.0.9",
    "husky": "^9.1.7",
    "prettier": "catalog:",
    "turbo": "^2.10.7"
  },
  "workspaces": [
    "lib",
    "core",
    "packages/*",
    "modules/*"
  ]
}