{
  "name": "@adeficior/monorepo",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "turbo run lint",
    "prepare": "husky && bun run scripts/prepare.ts"
  },
  "catalog": {
    "typescript": "^5",
    "zod": "^4.4.3",
    "lodash-es": "^4.18.1",
    "@types/lodash-es": "^4.17.12",
    "minimatch": "^10.2.6",
    "prettier": "^3.8.4"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.10.7",
    "prettier": "catalog:"
  },
  "workspaces": [
    "lib",
    "core",
    "packages/*",
    "modules/*"
  ]
}