{
   "name": "@adeficior/data-modifier-codegen",
   "version": "1.0.0",
   "exports": {
      ".": "./dist/index.js"
   },
   "types": "./dist/index.d.ts",
   "files": [
      "dist"
   ],
   "type": "module",
   "bin": {
      "datamod-codegen": "./dist/cli.ts"
   },
   "scripts": {
      "build": "tsc --project tsconfig.build.json",
      "check": "tsc --noEmit",
      "dev": "bun run build --watch",
      "lint": "eslint src",
      "prune": "bun run datamod-dev --prune",
      "prepare": "datamod-dev --setup",
      "test:ci": "bun run lint && bun run check"
   },
   "dependencies": {
      "arg": "^5.0.2"
   },
   "devDependencies": {
      "@adeficior/configs": "workspace:*",
      "@adeficior/data-modifier-core": "workspace:*"
   },
   "peerDependencies": {
      "typescript": "^5.9.3",
      "prettier": "^3.9.6",
      "lodash-es": "^4.18.1",
      "@adeficior/data-modifier-core": "workspace:*"
   }
}